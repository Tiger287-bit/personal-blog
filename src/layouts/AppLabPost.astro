---
import type { CollectionEntry } from 'astro:content';
import AppStatusBadge from '../components/AppStatusBadge.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SourceSidebar from '../components/SourceSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ArticleSourceLink } from '../sourceFiles';

interface ArticleHeading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'articles'>['data'] & {
	articleSlug: string;
	headings?: ArticleHeading[];
	sourceFiles?: ArticleSourceLink[];
};

const {
	title,
	description,
	appId = 'app-lab-tutorial',
	order = 1,
	status = 'planned',
	pubDate,
	updatedDate,
	verifiedDate,
	environment = [],
	capabilities = [],
	articleSlug,
	headings = [],
	sourceFiles = [],
} = Astro.props;

const stages = [
	{ id: 'planned', label: '准备' },
	{ id: 'in-progress', label: '编写' },
	{ id: 'verified', label: '验证' },
] as const;
const currentStage = stages.findIndex((stage) => stage.id === status);
const evidenceCopy = {
	planned: '教程准备中：运行步骤尚未完成验证。',
	'in-progress': '教程编写中：页面只展示已经确认的步骤。',
	verified: '已验证教程：核心步骤已经在标注环境中运行通过。',
}[status];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${title} | App Lab 教程`} description={description} />
	</head>
	<body>
		<Header />
		<main class:list={{ 'with-sources': sourceFiles.length > 0 }}>
			<article>
				<a class="back-link" href="/blog/sections/app-lab/">
					<span aria-hidden="true">←</span> 返回文章 · App Lab
				</a>

				<header class="bench-header">
					<div class="header-copy">
						<div class="app-identity">
							<span>APP {String(order).padStart(2, '0')}</span>
							<code>{appId}</code>
						</div>
						<h1>{title}</h1>
						<p>{description}</p>
						<div class="date-line">
							<span>建档 <FormattedDate date={pubDate} /></span>
							{updatedDate && <span>更新 <FormattedDate date={updatedDate} /></span>}
						</div>
					</div>

					<aside class="evidence-card" aria-label="教程验证状态">
						<div class="evidence-heading">
							<span>APP LAB GUIDE</span>
							<AppStatusBadge status={status} />
						</div>
						<div class="status-track" aria-label="教程完成状态">
							{stages.map((stage, index) => (
								<div class:list={{ reached: index <= currentStage, current: index === currentStage }}>
									<span aria-hidden="true"></span>
									<small>{stage.label}</small>
								</div>
							))}
						</div>
						<strong>{verifiedDate ? '最后实测日期' : '验证凭据'}</strong>
						<p>
							{verifiedDate ? <FormattedDate date={verifiedDate} /> : '等待首次真实运行'}
						</p>
					</aside>
				</header>

				<div class:list={['evidence-notice', status]}>
					<span aria-hidden="true">●</span>
					<p>{evidenceCopy}</p>
				</div>

				<div class="context-strip">
					<div>
						<strong>验证环境</strong>
						<ul>{environment.map((item) => <li>{item}</li>)}</ul>
					</div>
					<div>
						<strong>能力标签</strong>
						<ul>{capabilities.map((item) => <li>{item}</li>)}</ul>
					</div>
				</div>

				<div class:list={['reading-shell', { 'has-sources': sourceFiles.length > 0 }]}>
					<SourceSidebar articleSlug={articleSlug} section="app-lab" files={sourceFiles} />
					<TableOfContents headings={headings} />
					<div class="article-body">
						<span class="binder-mark" aria-hidden="true"></span>
						<div class="prose">
							<slot />
						</div>
						<footer class="record-end">
							<span>GUIDE END</span>
							<div>
								<strong>本篇教程到这里。</strong>
								<p>按标注环境执行命令，即可复现正文结果。</p>
							</div>
						</footer>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(var(--content-width), calc(100% - 3rem));
		padding-top: 3.25rem;
	}

	main.with-sources {
		width: min(1480px, calc(100% - 3rem));
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
		color: rgb(var(--gray));
		font-size: 0.72rem;
		font-weight: 700;
		text-decoration: none;
	}

	.back-link span {
		transition: transform 0.18s ease;
	}

	.back-link:hover span {
		transform: translateX(-3px);
	}

	.bench-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		align-items: end;
		gap: clamp(2rem, 7vw, 5rem);
		margin-bottom: 2rem;
	}

	.app-identity {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 1.15rem;
	}

	.app-identity > span {
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.app-identity code {
		font-size: 0.66rem;
	}

	.header-copy h1 {
		max-width: 760px;
		margin-bottom: 1rem;
		font-size: clamp(2.4rem, 5.7vw, 4.25rem);
	}

	.header-copy > p {
		max-width: 680px;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1.02rem;
	}

	.date-line {
		display: flex;
		gap: 1.1rem;
		margin-top: 1.2rem;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
		font-size: 0.66rem;
	}

	.evidence-card {
		position: relative;
		padding: 1.15rem;
		background:
			repeating-linear-gradient(0deg, transparent 0 25px, rgba(102, 191, 174, 0.08) 25px 26px),
			white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px 18px 14px 16px;
		box-shadow: 7px 8px 0 var(--lavender-soft);
		transform: rotate(1deg);
	}

	.evidence-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.evidence-heading > span {
		color: rgb(var(--gray));
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.status-track {
		position: relative;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin: 1.35rem 0 1.1rem;
	}

	.status-track::before {
		position: absolute;
		top: 0.32rem;
		left: 16.66%;
		width: 66.66%;
		height: 2px;
		content: '';
		background: rgb(var(--gray-light));
	}

	.status-track div {
		position: relative;
		z-index: 1;
		display: grid;
		justify-items: center;
		gap: 0.35rem;
		color: rgb(var(--gray));
	}

	.status-track div > span {
		width: 0.72rem;
		height: 0.72rem;
		background: white;
		border: 2px solid rgb(var(--gray-light));
		border-radius: 50%;
	}

	.status-track div.reached > span {
		background: var(--accent);
		border-color: white;
		box-shadow: 0 0 0 2px var(--accent);
	}

	.status-track div.current small {
		color: var(--accent-dark);
		font-weight: 700;
	}

	.status-track small {
		font-size: 0.62rem;
	}

	.evidence-card > strong {
		display: block;
		font-size: 0.72rem;
	}

	.evidence-card > p {
		margin: 0.15rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.7rem;
	}

	.evidence-notice {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		padding: 0.9rem 1.1rem;
		color: #5f568f;
		background: var(--lavender-soft);
		border: 1px solid rgba(139, 124, 197, 0.28);
		border-radius: 12px;
	}

	.evidence-notice.in-progress {
		color: #9a5062;
		background: var(--sakura-soft);
		border-color: rgba(242, 169, 184, 0.42);
	}

	.evidence-notice.verified {
		color: var(--accent-dark);
		background: var(--accent-soft);
		border-color: rgba(102, 191, 174, 0.4);
	}

	.evidence-notice > span {
		font-size: 0.65rem;
	}

	.evidence-notice p {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 700;
	}

	.context-strip {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-bottom: 2.2rem;
	}

	.context-strip > div {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.8rem;
		padding: 0.85rem 1rem;
		background: rgba(var(--surface), 0.72);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
	}

	.context-strip strong {
		font-size: 0.72rem;
		white-space: nowrap;
	}

	.context-strip ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.context-strip li {
		padding: 0.15rem 0.42rem;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
		font-size: 0.59rem;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 5px;
	}

	.reading-shell {
		display: grid;
		grid-template-columns: minmax(0, 860px) minmax(190px, 220px);
		align-items: start;
		justify-content: center;
		gap: clamp(1.5rem, 3vw, 2.25rem);
		width: 100%;
		margin: 0 auto;
	}

	.reading-shell :global(.toc-shell) {
		grid-row: 1;
		grid-column: 2;
		height: 100%;
		align-self: stretch;
	}

	.reading-shell.has-sources {
		grid-template-columns: minmax(190px, 220px) minmax(0, 860px) minmax(190px, 220px);
	}

	.reading-shell.has-sources :global(.source-shell) {
		grid-row: 1;
		grid-column: 1;
	}

	.reading-shell.has-sources :global(.toc-shell) {
		grid-column: 3;
	}

	.reading-shell.has-sources .article-body {
		grid-column: 2;
	}

	.article-body {
		position: relative;
		grid-row: 1;
		grid-column: 1;
		width: 100%;
		padding: clamp(3rem, 6vw, 4.4rem);
		background-color: rgba(var(--surface), 0.98);
		background-image:
			linear-gradient(90deg, transparent 0 2.5rem, rgba(242, 169, 184, 0.26) 2.5rem 2.56rem, transparent 2.56rem),
			repeating-linear-gradient(0deg, transparent 0 31px, rgba(102, 191, 174, 0.065) 31px 32px);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px 24px 18px 20px;
		box-shadow: var(--shadow-paper);
	}

	.binder-mark {
		position: absolute;
		top: -0.55rem;
		left: 10%;
		width: 5.4rem;
		height: 1.2rem;
		background: rgba(139, 124, 197, 0.42);
		clip-path: polygon(3% 7%, 98% 0, 94% 92%, 0 100%);
		transform: rotate(-2deg);
	}

	.record-end {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px dashed rgb(var(--gray-light));
	}

	.record-end > span {
		padding: 0.35rem 0.5rem;
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		background: var(--accent-soft);
		border-radius: 5px;
	}

	.record-end strong,
	.record-end p {
		display: block;
	}

	.record-end strong {
		font-family: var(--font-display);
		font-size: 0.95rem;
	}

	.record-end p {
		margin: 0.15rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	@media (max-width: 820px) {
		.bench-header,
		.context-strip {
			grid-template-columns: 1fr;
		}

		.evidence-card {
			width: min(380px, calc(100% - 0.5rem));
		}
	}

	@media (max-width: 980px) {
		.reading-shell {
			grid-template-columns: minmax(0, 860px);
			gap: 1rem;
		}

		.reading-shell :global(.toc-shell) {
			grid-row: 1;
			grid-column: 1;
			height: auto;
		}

		.article-body {
			grid-row: 2;
			grid-column: 1;
		}
	}

	@media (max-width: 1280px) {
		.reading-shell.has-sources {
			grid-template-columns: minmax(0, 860px);
			gap: 1rem;
		}

		.reading-shell.has-sources :global(.source-shell) {
			grid-row: 1;
			grid-column: 1;
			height: auto;
		}

		.reading-shell.has-sources :global(.toc-shell) {
			grid-row: 2;
			grid-column: 1;
			height: auto;
		}

		.reading-shell.has-sources :global(.desktop-toc) {
			display: none;
		}

		.reading-shell.has-sources :global(.mobile-toc) {
			display: block;
		}

		.reading-shell.has-sources .article-body {
			grid-row: 3;
			grid-column: 1;
		}
	}

	@media (max-width: 620px) {
		main {
			width: min(100% - 2rem, var(--content-width));
			padding-top: 2.4rem;
		}

		.header-copy h1 {
			font-size: clamp(2.25rem, 11vw, 3.25rem);
		}

		.date-line {
			flex-direction: column;
			gap: 0.25rem;
		}

		.context-strip > div {
			grid-template-columns: 1fr;
		}

		.article-body {
			padding: 2.8rem 1.2rem 1.8rem;
			background-image: repeating-linear-gradient(0deg, transparent 0 31px, rgba(102, 191, 174, 0.055) 31px 32px);
		}

		.record-end {
			align-items: start;
		}
	}
</style>
