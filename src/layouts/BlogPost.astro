---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FishMascot from '../components/FishMascot.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SourceSidebar from '../components/SourceSidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { ArticleSourceLink } from '../sourceFiles';

type Props = CollectionEntry<'articles'>['data'] & {
	articleSlug: string;
	category?: string;
	headings?: Array<{ depth: number; slug: string; text: string }>;
	sourceFiles?: ArticleSourceLink[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	articleSlug,
	section,
	category,
	headings = [],
	sourceFiles = [],
} = Astro.props;
const sectionLabel = category ?? '关于本站';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class:list={{ 'with-sources': sourceFiles.length > 0 }}>
			<article>
				<header class="article-header">
					<a class="back-link" href={category ? '/blog' : '/'}>
						<span aria-hidden="true">←</span> {category ? '返回文章分类' : '返回首页'}
					</a>
					<div class="article-meta">
						<span class="category">{sectionLabel}</span>
						<span class="meta-divider" aria-hidden="true"></span>
						<FormattedDate date={pubDate} />
					</div>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
					{
						updatedDate && (
							<p class="last-updated-on">
								最近更新于 <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={1120} height={560} src={heroImage} alt={title} />
						</div>
					)
				}

				<div class:list={['reading-shell', { 'has-sources': sourceFiles.length > 0 }]}>
					<SourceSidebar articleSlug={articleSlug} section={section} files={sourceFiles} />
					<TableOfContents headings={headings} />
					<div class="article-body">
						<span class="paper-tape" aria-hidden="true"></span>
						<div class="prose">
							<slot />
						</div>
						<div class="article-end">
							<div class="end-mascot"><FishMascot /></div>
							<div>
								<strong>这页先记到这里。</strong>
								<span>问题拆开一点，答案就会近一点。</span>
							</div>
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(var(--content-width), calc(100% - 3rem));
		padding-top: 3.5rem;
	}

	main.with-sources {
		width: min(1380px, calc(100% - 3rem));
	}

	.article-header {
		width: min(var(--reading-width), 100%);
		margin: 0 auto 3rem;
		text-align: left;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 3rem;
		color: rgb(var(--gray));
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-decoration: none;
	}

	.back-link span {
		transition: transform 0.18s ease;
	}

	.back-link:hover span {
		transform: translateX(-3px);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		color: rgb(var(--gray));
		font-size: 0.7rem;
	}

	.category {
		padding: 0.2rem 0.6rem;
		color: var(--accent-dark);
		font-weight: 700;
		background: var(--accent-soft);
		border: 1px solid rgba(102, 191, 174, 0.25);
		border-radius: 999px;
	}

	.meta-divider {
		width: 3px;
		height: 3px;
		background: var(--lavender);
		border-radius: 50%;
	}

	.article-header h1 {
		margin-bottom: 1.15rem;
		font-size: clamp(2.4rem, 5vw, 3.35rem);
	}

	.lede {
		max-width: 680px;
		margin: 0;
		color: rgb(var(--gray));
		font-size: clamp(1rem, 2.5vw, 1.14rem);
	}

	.last-updated-on {
		margin: 0.9rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.72rem;
		font-style: italic;
	}

	.hero-image {
		max-width: 980px;
		margin: 0 auto 2.5rem;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-paper);
	}

	.reading-shell {
		display: grid;
		grid-template-columns: minmax(0, var(--reading-width)) minmax(190px, 220px);
		align-items: start;
		justify-content: center;
		gap: clamp(1.5rem, 4vw, 2.75rem);
		width: 100%;
		margin: 0 auto;
	}

	.reading-shell :global(.toc-shell) {
		grid-row: 1;
		grid-column: 2;
		height: 100%;
		align-self: stretch;
	}

	.reading-shell.has-sources {
		grid-template-columns: minmax(190px, 220px) minmax(0, var(--reading-width)) minmax(190px, 220px);
	}

	.reading-shell.has-sources :global(.source-shell) {
		grid-row: 1;
		grid-column: 1;
	}

	.reading-shell.has-sources :global(.toc-shell) {
		grid-column: 3;
	}

	.reading-shell.has-sources .article-body {
		grid-column: 2;
	}

	.article-body {
		position: relative;
		grid-row: 1;
		grid-column: 1;
		width: 100%;
		padding: clamp(3.2rem, 6vw, 4.2rem);
		background: rgba(var(--surface), 0.97);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px 22px 18px 16px;
		box-shadow: var(--shadow-paper);
	}

	.article-body::before {
		position: absolute;
		top: 2.3rem;
		bottom: 2.3rem;
		left: 1.55rem;
		width: 1px;
		content: "";
		background: rgba(242, 169, 184, 0.58);
	}

	.paper-tape {
		position: absolute;
		top: -0.7rem;
		right: 12%;
		width: 5rem;
		height: 1.35rem;
		background: rgba(102, 191, 174, 0.45);
		clip-path: polygon(4% 6%, 100% 0, 95% 94%, 0 100%);
		transform: rotate(2deg);
	}

	.article-end {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px dashed rgb(var(--gray-light));
	}

	.end-mascot {
		width: 5.5rem;
		flex: 0 0 auto;
	}

	.article-end strong,
	.article-end span {
		display: block;
	}

	.article-end strong {
		font-family: var(--font-display);
		font-size: 1rem;
	}

	.article-end span {
		margin-top: 0.15rem;
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	@media (max-width: 720px) {
		main {
			width: min(100% - 2rem, var(--content-width));
			padding-top: 2.5rem;
		}

		.article-header {
			margin-bottom: 2.4rem;
		}

		.back-link {
			margin-bottom: 2.2rem;
		}

		.article-body {
			padding: 2.8rem 1.25rem 1.8rem;
			border-radius: 8px 16px 14px 12px;
		}

		.article-body::before {
			display: none;
		}

		.paper-tape {
			right: 9%;
		}

		.article-end {
			align-items: flex-start;
		}

		.end-mascot {
			width: 4.6rem;
		}
	}

	@media (max-width: 980px) {
		.reading-shell {
			grid-template-columns: minmax(0, var(--reading-width));
			gap: 1rem;
		}

		.reading-shell :global(.toc-shell) {
			grid-row: 1;
			grid-column: 1;
			height: auto;
		}

		.article-body {
			grid-row: 2;
			grid-column: 1;
		}
	}

	@media (max-width: 1280px) {
		.reading-shell.has-sources {
			grid-template-columns: minmax(0, var(--reading-width));
			gap: 1rem;
		}

		.reading-shell.has-sources :global(.source-shell) {
			grid-row: 1;
			grid-column: 1;
			height: auto;
		}

		.reading-shell.has-sources :global(.toc-shell) {
			grid-row: 2;
			grid-column: 1;
			height: auto;
		}

		.reading-shell.has-sources :global(.desktop-toc) {
			display: none;
		}

		.reading-shell.has-sources :global(.mobile-toc) {
			display: block;
		}

		.reading-shell.has-sources .article-body {
			grid-row: 3;
			grid-column: 1;
		}
	}
</style>
