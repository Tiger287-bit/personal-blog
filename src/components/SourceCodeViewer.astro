---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import type { ArticleSourceFile } from '../sourceFiles';

interface Props {
	file: ArticleSourceFile;
}

const { file } = Astro.props;
type CodeLanguage = ComponentProps<typeof Code>['lang'];
const highlighterLanguage = file.highlighterLanguage as CodeLanguage;
---

<div class="source-toolbar">
	<div>
		<span>{file.language}</span>
		<small>{file.previewable ? `${file.lineCount} 行` : '无法预览'}</small>
	</div>
	{
		file.previewable ? (
			<button type="button" data-copy-source>复制源码</button>
		) : (
			<a href={file.downloadUrl} download={file.name}>下载文件</a>
		)
	}
</div>

{
	file.previewable ? (
		<>
			<div class="source-code" tabindex="0" aria-label={`${file.path} 源码`} data-source-code>
				<div class="source-spectrum" aria-hidden="true" />
				<div class="highlighted-source">
					<Code code={file.content} lang={highlighterLanguage} theme="catppuccin-mocha" />
				</div>
			</div>

			<textarea
				class="source-copy-buffer"
				data-source-copy-buffer
				tabindex="-1"
				aria-hidden="true"
				value={file.content}
			/>
			<p class="copy-status" role="status" aria-live="polite" data-copy-status />
		</>
	) : (
		<div class="binary-preview" role="region" aria-label={`${file.path} 无法预览`}>
			<div class="binary-file-mark" aria-hidden="true"><span>BIN</span></div>
			<div>
				<p>此文件无法在网页中阅读</p>
				<h2>{file.name}</h2>
				<span>
					这是二进制文件，不是文本源码。文件已经完整保存在博客仓库中，可以直接下载使用。
				</span>
				<a href={file.downloadUrl} download={file.name}>下载原文件</a>
			</div>
		</div>
	)
}

<script>
	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-source]');
	const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]');
	const copyBuffer = document.querySelector<HTMLTextAreaElement>('[data-source-copy-buffer]');

	copyButton?.addEventListener('click', async () => {
		const source = copyBuffer?.value ?? '';
		try {
			await navigator.clipboard.writeText(source);
			copyButton.textContent = '已复制';
			if (copyStatus) copyStatus.textContent = '源码已复制到剪贴板。';
		} catch {
			if (copyStatus) copyStatus.textContent = '浏览器未允许复制，请手动选择源码。';
		}
	});
</script>

<style>
	.source-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.78rem 1rem;
		color: #dcebe8;
		background: #182033;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px 14px 0 0;
	}

	.source-toolbar div {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
	}

	.source-toolbar span,
	.source-toolbar small,
	.source-toolbar button,
	.source-toolbar > a {
		font-family: var(--font-mono);
	}

	.source-toolbar span {
		font-size: 0.72rem;
		font-weight: 700;
	}

	.source-toolbar small {
		color: #9fb6b2;
		font-size: 0.6rem;
	}

	.source-toolbar button,
	.source-toolbar > a {
		padding: 0.36rem 0.62rem;
		color: #dff8f2;
		font-size: 0.62rem;
		font-weight: 700;
		cursor: pointer;
		background: rgba(102, 191, 174, 0.16);
		border: 1px solid rgba(102, 191, 174, 0.45);
		border-radius: 6px;
		text-decoration: none;
	}

	.source-toolbar button:hover,
	.source-toolbar > a:hover {
		background: rgba(102, 191, 174, 0.28);
	}

	.source-toolbar button:focus-visible,
	.source-toolbar > a:focus-visible,
	.binary-preview a:focus-visible {
		outline: 2px solid #f2a9b8;
		outline-offset: 3px;
	}

	.source-code {
		position: relative;
		max-height: none;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.45;
		tab-size: 4;
		background: #20273d;
		border-radius: 0 0 14px 14px;
		scrollbar-color: var(--accent) rgba(255, 255, 255, 0.08);
	}

	.source-code:focus-visible {
		outline: 3px solid rgba(102, 191, 174, 0.48);
		outline-offset: 3px;
	}

	.source-spectrum {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1;
		height: 3px;
		background: linear-gradient(
			90deg,
			#66bfae 0 36%,
			#8b7cc5 36% 68%,
			#f2a9b8 68% 100%
		);
	}

	.highlighted-source {
		overflow: auto;
	}

	.highlighted-source :global(pre.astro-code) {
		min-width: max-content;
		margin: 0;
		padding: 1.25rem 0;
		overflow: visible;
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		background: #20273d !important;
		border: 0;
		border-radius: 0;
		box-shadow: none;
		counter-reset: source-line;
	}

	.highlighted-source :global(pre.astro-code::before),
	.highlighted-source :global(pre.astro-code::after) {
		display: none;
	}

	.highlighted-source :global(pre.astro-code > code) {
		all: unset;
		display: block;
		min-width: max-content;
		font-family: inherit;
	}

	.highlighted-source :global(.line) {
		position: relative;
		display: block;
		min-height: 1.45em;
		padding: 0 1.4rem 0 4.4rem;
		white-space: pre;
		counter-increment: source-line;
	}

	.highlighted-source :global(.line::before) {
		position: absolute;
		left: 0;
		width: 3.25rem;
		content: counter(source-line);
		color: #74889e;
		font-size: 0.68rem;
		text-align: right;
		user-select: none;
	}

	.highlighted-source :global(.line:hover) {
		background: rgba(102, 191, 174, 0.09);
	}

	.highlighted-source :global(::selection) {
		color: #fff;
		background: rgba(242, 169, 184, 0.34);
	}

	.source-copy-buffer {
		position: fixed;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: pre;
	}

	.copy-status {
		min-height: 1.4rem;
		margin: 0.55rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.68rem;
	}

	.binary-preview {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.1rem, 4vw, 2rem);
		min-height: 310px;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		background:
			linear-gradient(135deg, rgba(102, 191, 174, 0.08), transparent 46%),
			#20273d;
		border-radius: 0 0 14px 14px;
	}

	.binary-file-mark {
		position: relative;
		display: grid;
		width: 5.4rem;
		height: 6.8rem;
		place-items: end center;
		padding-bottom: 1.2rem;
		color: #e9e5fa;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		background: rgba(139, 124, 197, 0.18);
		border: 1px solid rgba(178, 164, 230, 0.72);
		border-radius: 5px 20px 5px 5px;
		box-shadow: 10px 12px 0 rgba(102, 191, 174, 0.1);
	}

	.binary-file-mark::before {
		position: absolute;
		top: -1px;
		right: -1px;
		width: 1.65rem;
		height: 1.65rem;
		content: '';
		background: #20273d;
		border-bottom: 1px solid rgba(178, 164, 230, 0.72);
		border-left: 1px solid rgba(178, 164, 230, 0.72);
	}

	.binary-preview p {
		margin: 0 0 0.35rem;
		color: #66bfae;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.binary-preview h2 {
		margin: 0 0 0.85rem;
		color: #f3f7f6;
		font-family: var(--font-mono);
		font-size: clamp(1rem, 2.5vw, 1.35rem);
		line-height: 1.45;
		word-break: break-all;
	}

	.binary-preview div > span {
		display: block;
		max-width: 42rem;
		color: #aebfcb;
		font-size: 0.78rem;
		line-height: 1.8;
	}

	.binary-preview a {
		display: inline-flex;
		margin-top: 1.25rem;
		padding: 0.62rem 0.9rem;
		color: #16212c;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		text-decoration: none;
		background: #66bfae;
		border-radius: 6px;
	}

	.binary-preview a:hover {
		background: #87d0c2;
	}

	@media (max-width: 620px) {
		.source-code {
			font-size: 0.7rem;
		}

		.highlighted-source :global(.line) {
			padding-right: 0.9rem;
			padding-left: 3.6rem;
		}

		.highlighted-source :global(.line::before) {
			width: 2.75rem;
		}

		.binary-preview {
			grid-template-columns: 1fr;
			min-height: 0;
		}

		.binary-file-mark {
			width: 4.25rem;
			height: 5.3rem;
		}
	}
</style>
