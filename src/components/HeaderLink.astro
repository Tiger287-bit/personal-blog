---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	activeFor?: string[];
};

const { href, class: className, activeFor = [], ...props } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathWithoutBase = basePath && Astro.url.pathname.startsWith(basePath)
	? Astro.url.pathname.slice(basePath.length)
	: Astro.url.pathname;
const pathname = pathWithoutBase.startsWith('/') ? pathWithoutBase : `/${pathWithoutBase}`;
const subpath = pathname.match(/[^\/]+/g);
const isActive =
	href === pathname ||
	href === '/' + (subpath?.[0] || '') ||
	activeFor.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
