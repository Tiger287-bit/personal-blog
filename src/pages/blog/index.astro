---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
	ARTICLE_SECTIONS,
	type ArticleSectionDefinition,
} from '../../articleSections';
import { SITE_TITLE } from '../../consts';

interface SectionCard extends ArticleSectionDefinition {
	id: string;
	articleCount: number;
}

const entries = await getCollection('articles');
const sectionCounts = entries.reduce(
	(counts, entry) => {
		counts[entry.data.section] = (counts[entry.data.section] ?? 0) + 1;
		return counts;
	},
	{} as Record<string, number>,
);
const sections: SectionCard[] = Object.entries(sectionCounts)
	.map(([sectionId, articleCount]) => ({
		id: sectionId,
		articleCount,
		...(ARTICLE_SECTIONS[sectionId] ?? {
			title: sectionId,
			label: 'TOPIC COLLECTION',
			description: `收录属于“${sectionId}”板块的教程与说明。`,
			tone: 'general' as const,
			order: 1000,
		}),
	}))
	.sort((a, b) => a.order - b.order);
const articleCount = entries.length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`文章板块 | ${SITE_TITLE}`}
			description="按主题板块进入咸鱼哥知识小库中的教程文章"
		/>
	</head>

	<body>
		<Header />

		<main>
			<header class="archive-heading">
				<div>
					<p class="section-label">教程书架</p>
					<h1>先选择板块，<br />再找到需要的教程。</h1>
					<p class="intro">
						这里不再堆叠所有文章。每个资料夹代表一个独立板块，进入后才显示其中的教程。
					</p>
				</div>
				<div class="archive-summary" aria-label="文章收录统计">
					<span aria-hidden="true"></span>
					<strong>{sections.length} 个板块</strong>
					<small>共收录 {articleCount} 篇文章</small>
				</div>
			</header>

			{
				sections.length > 0 ? (
					<section class="section-directory" aria-label="文章板块">
						{sections.map((section) => (
							<a
								class:list={['section-card', `tone-${section.tone}`]}
								href={`/blog/sections/${section.id}/`}
							>
								<span class="folder-tab" aria-hidden="true"></span>
								<header>
									<p>{section.label}</p>
									<small>{section.articleCount} 篇教程</small>
								</header>
								<h2>{section.title}</h2>
								<p class="section-description">{section.description}</p>
								<footer>
									<span>打开板块</span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M5 12h13M14 7l5 5-5 5" />
									</svg>
								</footer>
							</a>
						))}
					</section>
				) : (
					<div class="empty-state">
						<h2>文章书架已经准备好了</h2>
						<p>加入第一篇教程后，它会出现在所属板块中。</p>
					</div>
				)
			}
		</main>

		<Footer />
	</body>
</html>

<style>
	main {
		padding-top: 5rem;
	}

	.archive-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 3rem;
		margin-bottom: 5rem;
	}

	.archive-heading h1 {
		max-width: 850px;
		margin-bottom: 1rem;
		font-size: clamp(2.75rem, 6.7vw, 4.7rem);
	}

	.intro {
		max-width: 670px;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1.02rem;
	}

	.archive-summary {
		position: relative;
		display: flex;
		min-width: 11rem;
		padding: 1.1rem 1.2rem;
		flex-direction: column;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		box-shadow: var(--shadow-soft);
		transform: rotate(1.5deg);
	}

	.archive-summary > span {
		position: absolute;
		top: -0.55rem;
		left: 50%;
		width: 3.8rem;
		height: 1.05rem;
		background: rgba(139, 124, 197, 0.42);
		transform: translateX(-50%) rotate(-2deg);
	}

	.archive-summary strong {
		font-family: var(--font-display);
		font-size: 1rem;
	}

	.archive-summary small {
		margin-top: 0.25rem;
		color: rgb(var(--gray));
		font-size: 0.68rem;
	}

	.section-directory {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr));
		gap: clamp(1.5rem, 4vw, 2.25rem);
		margin-bottom: 4rem;
	}

	.section-card {
		position: relative;
		display: flex;
		min-height: 310px;
		padding: 2rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		flex-direction: column;
		background:
			linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(239, 236, 250, 0.6));
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px var(--radius-md) var(--radius-md) var(--radius-md);
		box-shadow: var(--shadow-soft);
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}

	.section-card.tone-lab {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(227, 245, 240, 0.72));
	}

	.section-card.tone-brick {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(232, 242, 252, 0.78));
	}

	.section-card.tone-ros {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(229, 237, 250, 0.82));
	}

	.section-card.tone-hardware {
		background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(252, 236, 240, 0.72));
	}

	.folder-tab {
		position: absolute;
		top: -0.95rem;
		left: -1px;
		width: 44%;
		height: 1rem;
		background: var(--lavender);
		border-radius: 8px 18px 0 0;
		transition: width 0.2s ease;
	}

	.tone-lab .folder-tab {
		background: var(--accent);
	}

	.tone-brick .folder-tab {
		background: #6f9fc8;
	}

	.tone-ros .folder-tab {
		background: #5476a6;
	}

	.tone-hardware .folder-tab {
		background: var(--sakura);
	}

	.section-card:hover {
		color: rgb(var(--gray-dark));
		border-color: rgba(102, 191, 174, 0.68);
		box-shadow: var(--shadow-paper);
		transform: translateY(-4px) rotate(-0.25deg);
	}

	.section-card:hover .folder-tab {
		width: 52%;
	}

	.section-card:focus-visible {
		outline: 3px solid rgba(102, 191, 174, 0.48);
		outline-offset: 4px;
	}

	.section-card header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 2.2rem;
	}

	.section-card header p {
		margin: 0;
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.section-card header small {
		padding: 0.22rem 0.55rem;
		color: rgb(var(--gray-dark));
		font-size: 0.6rem;
		font-weight: 700;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid rgba(var(--gray-light), 0.95);
		border-radius: 999px;
		white-space: nowrap;
	}

	.section-card h2 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.75rem, 4vw, 2.45rem);
		transition: color 0.18s ease;
	}

	.section-card:hover h2 {
		color: var(--accent-dark);
	}

	.section-description {
		max-width: 32rem;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.84rem;
		line-height: 1.7;
	}

	.section-card footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: auto;
		padding-top: 2rem;
		color: rgb(var(--black));
		font-size: 0.76rem;
		font-weight: 700;
	}

	.section-card footer svg {
		width: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.7;
		transition: transform 0.18s ease;
	}

	.section-card:hover footer svg {
		transform: translateX(4px);
	}

	.empty-state {
		padding: 5rem 1.5rem;
		text-align: center;
		background: white;
		border: 1px dashed rgb(var(--gray-light));
		border-radius: var(--radius-md);
	}

	.empty-state h2 {
		font-size: 1.6rem;
	}

	.empty-state p {
		margin: 0;
		color: rgb(var(--gray));
	}

	@media (prefers-reduced-motion: reduce) {
		.section-card,
		.folder-tab,
		.section-card footer svg {
			transition: none;
		}
	}

	@media (max-width: 720px) {
		main {
			padding-top: 3rem;
		}

		.archive-heading {
			grid-template-columns: 1fr;
			gap: 2rem;
			margin-bottom: 4rem;
		}

		.archive-summary {
			justify-self: start;
		}

		.section-directory {
			gap: 1.8rem;
		}

		.section-card {
			min-height: 280px;
			padding: 1.5rem;
		}
	}
</style>
