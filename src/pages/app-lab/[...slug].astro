---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import AppLabPost from '../../layouts/AppLabPost.astro';
import { getArticleSourceFiles } from '../../sourceFiles';

export async function getStaticPaths() {
	const entries = await getCollection('articles', ({ data }) => data.section === 'app-lab');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}

type Props = CollectionEntry<'articles'>;

const entry = Astro.props;
const { Content, headings } = await render(entry);
const sourceFiles = getArticleSourceFiles(entry.data.sourceDir);
---

<AppLabPost {...entry.data} articleSlug={entry.id} headings={headings} sourceFiles={sourceFiles}>
	<Content />
</AppLabPost>
